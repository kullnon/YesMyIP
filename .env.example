# YesMyIP — environment variables for the Vercel serverless functions in /api.
# Set these in Vercel → Project → Settings → Environment Variables.
# Nothing here is read by the static pages; only /api/* sees them.

# --- Admin login (api/login.js, api/verify.js, api/stats.js) ---
# JSON array. Make a hash with:  node api/_lib/hash-password.js '<password>'
ADMIN_USERS=[{"username":"andy","name":"Andy","role":"admin","hash":"scrypt$<salt>$<key>"}]
# 32+ random chars:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- First-party analytics (api/track.js, api/stats.js) ---
# Supabase project for yesmyip. Apply supabase/001_analytics.sql first.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key: server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_KEY=
